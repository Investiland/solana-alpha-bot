# ============================================================
# Variables OBLIGATOIRES (à renseigner dans Render > Environment)
# Ne jamais mettre les vraies valeurs dans GitHub.
# ============================================================
BIRDEYE_API_KEY=ta_cle_birdeye
SUPABASE_URL=https://xxxx.supabase.co
# Supabase > Project Settings > API > service_role (secrète, backend uniquement)
SUPABASE_SERVICE_ROLE_KEY=ta_cle_service_role
TELEGRAM_BOT_TOKEN=ton_token_telegram
TELEGRAM_CHAT_ID=ton_chat_id

# Ancienne clé, utilisée seulement si SUPABASE_SERVICE_ROLE_KEY est absente
# SUPABASE_ANON_KEY=

# ============================================================
# Réglages OPTIONNELS (valeurs par défaut indiquées)
# ============================================================
# DRY_RUN=false                 # true = aucune écriture Supabase ni message Telegram

# --- Univers ---
# MIN_MARKET_CAP=500000
# MAX_MARKET_CAP=10000000
# MIN_LIQUIDITY=50000
# MIN_LIQUIDITY_TO_MCAP=0.08    # liquidité >= 8 % du market cap
# MIN_VOLUME_24H=50000
# UNIVERSE_SORT_BY=volume_24h_usd
# UNIVERSE_PAGES=1              # 1 page = 100 tokens = 50 CU par scan

# --- Filtres ---
# MIN_AGE_HOURS=48
# MAX_TOP10_SHARE=0.4           # top 10 holders > 40 % = rejet
# MAX_PUMP_1H=60                # déjà +60 % en 1 h = rejet
# MAX_LIQUIDITY_DROP_1H=15
# MIN_MOVE_5M=2
# MIN_MOVE_1H=5

# --- Niveaux ---
# ALERT_SCORE=58
# CRITICAL_SCORE=72
# EXIT_SCORE=40
# EXIT_SCANS=2
# REOPEN_WINDOW_MINUTES=60

# --- Suivi des résultats ---
# WIN_THRESHOLD=20              # +20 % atteint...
# LOSS_THRESHOLD=15             # ...avant -15 % = détection réussie

# --- Budget Birdeye ---
# MAX_OVERVIEW_PER_SCAN=6       # 15 CU chacun
# MAX_SECURITY_PER_SCAN=8       # 25 CU chacun, mis en cache 24 h
# SNAPSHOT_RETENTION_DAYS=3

# --- Telegram ---
# TELEGRAM_MIN_LEVEL=alert      # ou critical
